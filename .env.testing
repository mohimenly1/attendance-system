APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:cNzXIWZvd9Yz3+VpTrtHfUX7dWMkeRwAinHR57Dyd+8=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----- Database -----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendance_system_test
DB_USERNAME=root
DB_PASSWORD=

# ----- Sessions / Cache / Queue -----
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=127.0.0.1

CACHE_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ----- Redis (لو ما تستخدمه مافيش مشكلة) -----
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----- Mail (تجريبي) -----
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----- Face Recognition (Flask) -----
FACE_RECOGNITION_URL=http://127.0.0.1:5000/recognize-face

VITE_APP_NAME="${APP_NAME}"
